# 鹏城舆情分析平台 —— 环境变量示例（仅占位值，真实 .env 请勿提交）
# 复制为 backend/.env 并按需修改。
# 注意：本平台通过「操作系统环境变量」读取配置（不自动加载 .env 文件）。
# 生产启动前请在上述变量所在的环境中导出（如 systemd Environment、Docker ENV、k8s Secret），
# 例如：export SECRET_KEY=$(python -c "import secrets;print(secrets.token_hex(32))")

# 服务
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 安全（生产务必替换为强随机值；未设置时平台会生成临时随机密钥，重启后旧令牌失效，仅适合单实例演示）
# 生成强密钥（32 字节 = 64 位十六进制），在启动环境中执行：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 多副本/生产部署：所有副本必须设置「同一把」SECRET_KEY，否则 A 副本签发令牌在 B 副本校验会失败。
SECRET_KEY=__REPLACE_WITH_64HEX_FROM_secrets_token_hex_32__
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 跨域（生产改为显式前端来源，禁用通配符）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 数据集路径（默认指向 app/data/dataset.json，先运行生成脚本）
DATASET_PATH=

# 模拟 LLM（演示态默认 true；生产改为 false 并配置下方真实模型）
USE_MOCK_LLM=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# 风险预警阈值
RISK_NEGATIVE_RATIO=0.45
RISK_VOLUME=200
BURST_MULTIPLIER=2.5

# 演示种子账号口令（生产请覆盖为强口令或接入真实用户库）
# 不设上述任一变量时，该账号启动期生成随机强口令并打印到启动日志（不再有 admin123 等硬编码默认），重启未设环境变量会重新生成
ADMIN_PASSWORD=admin123
ANALYST_PASSWORD=analyst123
PR_PASSWORD=pr123
